{
  "name": "@crispr/observability",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.ts",
      "bun": "./lib/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./index": {
      "types": "./lib/index.ts",
      "bun": "./lib/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/exporter-logs-otlp-grpc": "^0.223.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-logs": "^0.223.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "pino": "^10.1.0"
  },
  "devDependencies": {
    "@crispr/eslint-config": "workspace:*",
    "@crispr/typescript-config": "workspace:*",
    "@types/bun": "^1.3.12",
    "@types/node": "26.4.1",
    "eslint": "10.9.1",
    "typescript": "7.0.2"
  },
  "scripts": {
    "build": "bun build ./lib/index.ts --outdir ./dist --target node --format esm --packages external --entry-naming [name].js",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "bun test",
    "check-types": "tsc --noEmit -p tsconfig.json"
  }
}

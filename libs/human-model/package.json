{
  "name": "@crispr/human-model",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/human-model.tsx",
    "./anatomy": "./src/anatomy.ts",
    "./profiles": "./src/profiles.ts",
    "./dna": "./src/dna-helix.tsx",
    "./dna-sequence": "./src/dna-sequence.ts",
    "./asset-manifest": "./dist/assets/manifest.json"
  },
  "scripts": {
    "build": "bun scripts/build-assets.ts",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "check-types": "tsc --noEmit",
    "test": "bun test",
    "export:model": "bun run scripts/export-model.ts",
    "verify:model": "bun run scripts/verify-model.ts",
    "segment:model": "bun run scripts/blender/export-segmented-models.ts all",
    "inspect:blender": "bun run scripts/blender/export-segmented-models.ts --inspect all",
    "verify:segments": "bun run scripts/verify-segmented-models.ts",
    "verify:mcp": "bun run scripts/verify-mcp.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "meshoptimizer": "^1.0.1",
    "three": "^0.185.1"
  },
  "peerDependencies": {
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@crispr/eslint-config": "workspace:*",
    "@gltf-transform/core": "^4.2.1",
    "@gltf-transform/extensions": "^4.2.1",
    "@gltf-transform/functions": "^4.2.1",
    "@types/bun": "^1.3.14",
    "@types/react": "19.2.18",
    "@types/three": "^0.185.1",
    "happy-dom": "^20.8.4",
    "eslint": "10.9.1",
    "typescript": "^7.0.2"
  }
}

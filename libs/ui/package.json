{
  "name": "@crispr/ui",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./components/*": "./src/components/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./hooks/*": "./src/hooks/*.ts",
    "./button": "./src/components/button.tsx",
    "./card": "./src/components/card.tsx",
    "./genome/report": "./src/genome/report.ts",
    "./genome/genome.module.css": "./src/genome/genome.module.css",
    "./*": "./src/*.tsx"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "generate:component": "turbo gen react-component",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@crispr/eslint-config": "workspace:*",
    "@crispr/typescript-config": "workspace:*",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "10.9.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "@crispr/human-model": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}

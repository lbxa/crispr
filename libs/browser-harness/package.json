{
  "name": "@crispr/browser-harness",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./dist/index.js"
    }
  },
  "bin": {
    "browser-harness": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc && bun scripts/verify-built-package.ts",
    "cli": "bun src/cli.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "check-types": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "install:browsers": "playwright install chromium",
    "smoke": "bun src/cli.ts smoke",
    "verify:next": "bun scripts/verify-next.ts",
    "verify:chat": "bun scripts/verify-chat.ts",
    "verify:upload": "bun scripts/verify-genome-upload.ts",
    "verify:regions": "bun scripts/verify-genome-upload.ts --findings",
    "verify:body": "bun scripts/verify-body-map.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@crispr/observability": "workspace:*",
    "commander": "^14.0.2",
    "playwright": "^1.61.0",
    "tree-kill": "^1.2.2",
    "yaml": "^2.8.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@crispr/eslint-config": "workspace:*",
    "@crispr/typescript-config": "workspace:*",
    "@types/bun": "^1.3.14",
    "@types/node": "26.4.1",
    "eslint": "10.9.1",
    "typescript": "7.0.2"
  }
}

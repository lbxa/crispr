# Copy to apps/web/.env.local. All of these are server-only; none reach the browser.

# /chat model. Without a key the chat runs the demo model, which restates retrieved
# facts and says so on screen.
AI_GATEWAY_API_KEY=
# Optional Vercel AI Gateway model id (default anthropic/claude-sonnet-5.5), or "demo".
CRISPR_MODEL=

# Optional paths to the offline imports (defaults: libs/chat-agent/data/*.json).
# Build the ClinVar file with: bun run --cwd libs/chat-agent clinvar:download && bun run --cwd libs/chat-agent clinvar:import
CRISPR_CLINVAR_DATA=
CRISPR_PATIENTS_DATA=

# "ensembl" fetches real GRCh38 windows from rest.ensembl.org (verified against the
# stored reference allele); anything else keeps the labelled synthetic sequence.
CRISPR_SEQUENCE=

# Genome analysis and CRISPR plan backend (see README).
CRISPR_API_URL=

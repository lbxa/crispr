{$CRISPR_HOST} {
	# Security headers on every response; never advertise the server software.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		-Server
	}

	# Internal capability checks and tus hooks are reachable only over loopback.
	# This must be a `handle` block: Caddy orders `handle` before `respond`, so a
	# bare `respond` here would be skipped by the catch-all `handle` below.
	handle /internal/* {
		respond 404
	}

	handle /files/* {
		@creation method POST
		request_body @creation {
			max_size 1KB
		}
		# Preflights have no capability. tusd applies its configured CORS policy.
		@preflight method OPTIONS
		handle @preflight {
			reverse_proxy 127.0.0.1:1080
		}
		handle {
			forward_auth 127.0.0.1:8000 {
				uri /internal/uploads/authorize
			}
			# Caddy streams the body; never enable request_buffers here.
			reverse_proxy 127.0.0.1:1080
		}
	}

	handle {
		# Control-plane JSON remains small even though /files accepts large streams.
		@uploadControl path /uploads /uploads/*
		request_body @uploadControl {
			max_size 64KB
		}
		# Everything else is JSON; /analyze carries at most a 20 MiB VCF.
		@otherBodies not path /uploads /uploads/*
		request_body @otherBodies {
			max_size 21MB
		}
		reverse_proxy 127.0.0.1:8000
	}
}

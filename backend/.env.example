# Copy to backend/.env (git-ignored) and fill in. Never commit the real file.
# Write values without quotes: KEY=value
# backend/scripts/deploy.sh uploads backend/.env to the server (readable only by linux1).

# Which language model reads symptom text: gemini | granite | none.
# Blank: gemini if GEMINI_API_KEY is set, otherwise granite where available.
CRISPR_LLM=

# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the Gemini model.
GEMINI_MODEL=gemini-3.6-flash

# Large genomes: durable storage and job state, separate from CRISPR_DB.
# deploy.sh supplies /data/uploads and the public HTTPS /files/ endpoint.
# Local development: use an absolute directory and your local Caddy /files/ URL.
# CRISPR_UPLOAD_DIR=/absolute/path/to/uploads
# CRISPR_UPLOAD_PUBLIC_URL=http://127.0.0.1:9080/files/
# CRISPR_MAX_UPLOAD_BYTES=10737418240
# CRISPR_UPLOAD_QUOTA_BYTES=42949672960
# CRISPR_UPLOAD_DISK_RESERVE_BYTES=2147483648
# CRISPR_UPLOAD_RETENTION_SECONDS=86400
# CRISPR_TUSD_INTERNAL_URL=http://127.0.0.1:1080/files/
# CRISPR_UPLOAD_RESERVATION_TTL_SECONDS=300
# CRISPR_MAX_ACTIVE_UPLOADS_PER_SOURCE=2
# CRISPR_UPLOAD_CREATIONS_PER_MINUTE=6
# CRISPR_UPLOAD_SOURCE_QUOTA_BYTES=10737418240

# CRISPRon scoring service (see scoring_service/). Blank: reports have no advisability score.
CRISPRON_URL=
